<Project>
  <!--
    Central Package Management at the REPO ROOT: this file governs every MSBuild project in the
    tree. Do NOT add a second Directory.Packages.props below it: it would shadow this file for
    everything underneath and split version governance in two. Transitive pinning is
    intentionally OFF: only direct references need a version here. VersionOverride is disabled:
    a project cannot declare a version of its own.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup Label="ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="PostgreSQL">
    <!-- A direct reference wherever PostgreSQL is reached, the migration runner included, so that
         every project resolves this version rather than the one dbup-postgresql pulls. -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="dbup-postgresql" Version="7.0.1" />
  </ItemGroup>
  <ItemGroup Label="MicroKit libraries (ADR-ARCH-035)">
    <!-- The versions MicroKit pinned at the commit libraries/ was copied from, except where this
         file already pinned the package (Npgsql above). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <!-- Referenced with PrivateAssets="all" by MicroKit.Persistence.Analyzers only: the compiler
         that loads the analyzer provides Roslyn (ADR-ARCH-035 §5). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup Label="Testing (ADR-ARCH-021)">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup Label="Testing the MicroKit libraries (ADR-ARCH-021, ADR-ARCH-035 §7)">
    <!-- MicroKit's pins at the copied commit, for the packages its tests keep. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <!-- Referenced directly by the EF Core integration tests: the SQLite provider above brings the
         SQLitePCLRaw family at 2.1.11, whose SQLitePCLRaw.lib.e_sqlite3 GHSA-2m69-gcr7-jv3q covers
         (<= 2.1.11). Every package of the family the restore resolves is pinned to one version, as
         its packages ship in lockstep: 2.1.12 moves the native library to SQLite 3.53.3, 2.1.13
         drops win-arm from its targets, 2.1.14 gives the providers' callbacks an explicit Cdecl
         calling convention. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="2.1.14" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.2" />
    <!-- Referenced by the analyzer tests only: transitive pinning is off, so the testing packages
         above would otherwise compile them against the Roslyn 1.0.1 they declare. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <!-- The test stack of ADR-ARCH-021 in place of MicroKit's: the xUnit v3 integration of FsCheck
         (needs xunit.v3.extensibility.core [4.0.0, 5.0.0)) and ArchUnitNET with its xUnit v3
         integration (ADR-ARCH-034 §7), latest stable on 2026-11-16. Mono.Cecil at the version
         TngTech.ArchUnitNET 0.13.5 declares, for the IL scans the tests write themselves. -->
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.6.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.5" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
