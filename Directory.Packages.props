<Project>
  <!--
    Central Package Management at the REPO ROOT: this file governs every MSBuild project in the
    tree. Do NOT add a second Directory.Packages.props below it: it would shadow this file for
    everything underneath and split version governance in two. Transitive pinning is
    intentionally OFF: only direct references need a version here.
    No package is pinned yet — versions are added with the first project that references them.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
