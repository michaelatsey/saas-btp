<Project>

  <!--
    Repo-root MSBuild defaults: this file sits at the solution root and governs EVERY MSBuild
    project in the tree, in the layout of ADR-ARCH-020 and ADR-ARCH-034:
      apps/api/src/hosts/<Project>/        the hosts
      apps/api/src/modules/<Context>/      the bounded-context modules, their tests in tests/
      apps/api/tests/<Project>/            the test projects that belong to no module
      apps/api/database/SaasBtp.Migrations the schema migration runner (ADR-ARCH-019)
      libraries/                           the .NET libraries owned by this repository, their
                                           tests in each library's tests/ (ADR-ARCH-035)
    No nested Directory.Build.props is added below it: it would shadow this file for everything
    underneath. Only affects MSBuild projects; the pnpm side of the repo is untouched.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Test projects (ADR-ARCH-021): the name of a test states what it proves, so a missing XML
    comment (CS1591) is not reported there. Documentation generation stays on, so a malformed
    XML comment is still reported. Test projects are recognized by the name ADR-ARCH-020 gives
    them: <TestedProject>.Tests or <TestedProject>.IntegrationTests.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    A green run never holds a test that did not run. dotnet test passes these arguments to
    every test project, with or without a build: a skipped test fails the run, and an explicit
    test, which xUnit otherwise reports as skipped, runs like any other. Either option given
    again on the command line stops the run with exit code 5.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --fail-skips on --explicit on</TestingPlatformCommandLineArguments>
  </PropertyGroup>

</Project>
