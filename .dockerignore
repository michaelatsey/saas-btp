# Build context of the API and migration runner images (ADR-ARCH-022): the repository root.
# Allow-list: everything is excluded, then only what a Dockerfile copies is let back in, so a
# local secret file can never reach the build context.
*

!global.json
!Directory.Build.props
!Directory.Packages.props
!.editorconfig
!apps/api/src/hosts/SaasBtp.Api/
!apps/api/src/hosts/SaasBtp.Api.HealthProbe/
!apps/api/src/modules/Access/SaasBtp.Access.Domain/
!apps/api/src/modules/Access/SaasBtp.Access.Features/
!apps/api/src/modules/Access/SaasBtp.Access.Adapters/
!libraries/MicroKit.Domain/src/MicroKit.Domain/
!libraries/MicroKit.Result/src/MicroKit.Result/
!libraries/MicroKit.Persistence/src/MicroKit.Persistence.Abstractions/
!libraries/MicroKit.Persistence/src/MicroKit.Persistence/
!libraries/MicroKit.Persistence/src/MicroKit.Persistence.EntityFrameworkCore/
!libraries/MicroKit.Persistence/src/MicroKit.Persistence.EntityFrameworkCore.PostgreSql/
!libraries/MicroKit.Persistence/src/MicroKit.Persistence.Analyzers/
!apps/api/database/SaasBtp.Migrations/

# Excluded again inside the projects let back in: local build output, and the files the root
# .gitignore treats as secrets.
**/bin/
**/obj/
**/.env
**/.env.*
**/appsettings.Development.json
**/http-client.env.json
**/Dockerfile
