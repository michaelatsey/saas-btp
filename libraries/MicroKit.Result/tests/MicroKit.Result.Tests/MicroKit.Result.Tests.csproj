<Project Sdk="Microsoft.NET.Sdk">

  <!-- Copied from MicroKit's MicroKit.Result.UnitTests (see ../../README.md), on the test stack of
       ADR-ARCH-021 (ADR-ARCH-035 §7). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
