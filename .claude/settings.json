{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(graph.json)",
      "Read(graphify-out/**/*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(appsettings.Development.json)",
      "Read(http-client.env.json)",
      "Read(*.key)",
      "Read(*.pem)",
      "Read(*.pfx)",
      "Read(*.p12)",
      "Read(*.p8)",
      "Read(*.jks)",
      "Read(*.keystore)",
      "Read(*.mobileprovision)",
      "Bash(gh pr merge *)",
      "Bash(gh api */pulls/*/merge*)",
      "Bash(gh api *mergePullRequest*)",
      "Bash(gh api *enablePullRequestAutoMerge*)"
    ]
  },
  "hooks": {
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"${CLAUDE_PROJECT_DIR}/.claude/logs\" && jq -c '{ts: (now | todate), file_path, memory_type, load_reason}' >> \"${CLAUDE_PROJECT_DIR}/.claude/logs/instructions-loaded.jsonl\""
          }
        ]
      }
    ]
  }
}
