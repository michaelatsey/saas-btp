<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- See SaasBtp.Site.UnitTests: doc + performance analyzers are scoped out of test code. -->
    <NoWarn>CS1591;CA1707;CA2007;CA2012;CA1859;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The raw-Npgsql scope provider under test, and the DbUp migrator whose runner + embedded scripts
         build the schema it queries (single DDL source — ADR-ARCH-006). No EF: the provider is plain
         Npgsql over site.* + access.*. -->
    <ProjectReference Include="..\..\src\Modules\Site\SaasBtp.Site.Infrastructure\SaasBtp.Site.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\..\tools\database-migrator\SaasBtp.Database.Migrator\SaasBtp.Database.Migrator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
