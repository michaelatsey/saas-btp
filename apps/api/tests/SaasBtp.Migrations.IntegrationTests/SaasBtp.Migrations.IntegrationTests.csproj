<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../database/SaasBtp.Migrations/SaasBtp.Migrations.csproj" />
    <!-- The roles of infra/supabase/roles.sql on the container, and the runner (ADR-ARCH-032, Consequences). -->
    <ProjectReference Include="../SaasBtp.Testing/SaasBtp.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../PostgresImage.cs" Link="PostgresImage.cs" />
    <AssemblyMetadata Include="ComposeFilePath" Value="$(MSBuildProjectDirectory)/../../../../infra/docker/compose.dev.yml" />
    <!-- Files the auth-coupled script tests read: they keep the local Migrate step, the staging deployment and roles.sql in step with the exclusion list. -->
    <AssemblyMetadata Include="ApiGuidePath" Value="$(MSBuildProjectDirectory)/../../CLAUDE.md" />
    <AssemblyMetadata Include="DeployStagingWorkflowPath" Value="$(MSBuildProjectDirectory)/../../../../.github/workflows/deploy-api-staging.yml" />
    <AssemblyMetadata Include="RolesScriptPath" Value="$(MSBuildProjectDirectory)/../../../../infra/supabase/roles.sql" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
