<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- CA1707: test names carry the identifier they prove, with underscores: the scenario
         identifiers (BP001_AC_11_...) as issues-convention.md §12 states, and, by this project's
         naming, the ADR whose decision a test checks (Adr038_...). -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- The tests build and sign tokens (JsonWebTokenHandler), read the host's JwtBearerOptions and
         move the clock of its key manager (ADR-ARCH-038 decision 9). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/hosts/SaasBtp.Api/SaasBtp.Api.csproj" />
    <!-- The subject port the host implements (ADR-ARCH-035 §8), which the tests resolve. -->
    <ProjectReference Include="../../../../libraries/MicroKit.Persistence/src/MicroKit.Persistence.EntityFrameworkCore.PostgreSql/MicroKit.Persistence.EntityFrameworkCore.PostgreSql.csproj" />
    <!-- A database migrated by the runner, for the founding's host tests (ADR-ARCH-034 §6). -->
    <ProjectReference Include="../SaasBtp.Testing/SaasBtp.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../PostgresImage.cs" Link="PostgresImage.cs" />
    <AssemblyMetadata Include="OpenApiDocumentPath" Value="$(MSBuildProjectDirectory)/../../openapi/v1.json" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
