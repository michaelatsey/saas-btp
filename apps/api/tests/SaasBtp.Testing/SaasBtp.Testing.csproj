<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The shared support of the integration tests (ADR-ARCH-034 §6): the PostgreSQL the tests start,
    the roles of infra/supabase/roles.sql applied to it, and the migration runner run on it as
    saasbtp_migrator (ADR-ARCH-032, Consequences). Its name does not end in Tests, so its public
    types carry XML comments (ADR-ARCH-021). It references no test framework: each test project
    wraps it in a fixture of its own.
  -->

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <!-- The runner is started as its own process (Runner.cs). -->
  <ItemGroup>
    <ProjectReference Include="../../database/SaasBtp.Migrations/SaasBtp.Migrations.csproj" />
  </ItemGroup>

  <!--
    The runner's own build output, every file of it, copied under migration-runner/ in the output of
    this project and of each project that references it, where Runner.cs starts it. The runner then
    runs with its own deps.json and dependencies, whatever its consumer runs on: a consumer on the
    ASP.NET Core shared framework gets no copy of the Microsoft.Extensions.*.Abstractions packages the
    runner needs, since that framework provides them, and the runner runs on Microsoft.NETCore.App
    only (#218).
  -->
  <Target Name="IncludeMigrationRunner" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="../../database/SaasBtp.Migrations/SaasBtp.Migrations.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_MigrationRunnerAssembly" />
    </MSBuild>
    <PropertyGroup>
      <_MigrationRunnerDirectory>@(_MigrationRunnerAssembly->'%(RootDir)%(Directory)')</_MigrationRunnerDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_MigrationRunnerFile Include="$(_MigrationRunnerDirectory)**/*" />
      <None Include="@(_MigrationRunnerFile)"
            Link="migration-runner/%(RecursiveDir)%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <Error Condition="!Exists('$(_MigrationRunnerDirectory)SaasBtp.Migrations.deps.json')"
           Text="The migration runner's build output was not found in '$(_MigrationRunnerDirectory)'." />
  </Target>

  <ItemGroup>
    <Compile Include="../PostgresImage.cs" Link="PostgresImage.cs" />
    <!-- The file the maintainer runs on each project, applied as it is to every test database. -->
    <EmbeddedResource Include="../../../../infra/supabase/roles.sql" LogicalName="roles.sql" />
  </ItemGroup>

</Project>
