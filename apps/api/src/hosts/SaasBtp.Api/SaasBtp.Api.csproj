<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The build writes the OpenAPI document "v1" to apps/api/openapi/v1.json, where it is
    committed (ADR-ARCH-018). CI fails when the build output differs from the committed file.
    The file name is set here for the one document that exists: a second major needs its own
    naming before it is added.
  -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>../../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name v1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <!-- Each module through its Adapters project only, whose entry point Program.cs calls by type
       (ADR-ARCH-034 §2). -->
  <ItemGroup>
    <ProjectReference Include="../../modules/Access/SaasBtp.Access.Adapters/SaasBtp.Access.Adapters.csproj" />
  </ItemGroup>

  <!-- The copied PostgreSQL provider, for its subject port, which the host implements from the
       validated token (ADR-ARCH-035 §8). It brings MicroKit.Persistence.EntityFrameworkCore,
       MicroKit.Persistence, MicroKit.Persistence.Abstractions, MicroKit.Result and MicroKit.Domain
       into the closure the Dockerfile copies (ADR-ARCH-035 §5). -->
  <ItemGroup>
    <ProjectReference Include="../../../../../libraries/MicroKit.Persistence/src/MicroKit.Persistence.EntityFrameworkCore.PostgreSql/MicroKit.Persistence.EntityFrameworkCore.PostgreSql.csproj" />
  </ItemGroup>

</Project>
